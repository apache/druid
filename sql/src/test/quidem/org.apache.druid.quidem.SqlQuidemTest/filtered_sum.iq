!use druidtest://?numMergeBuffers=3
!set outputformat mysql

-- empty input
SELECT COUNT(1)FILTER(WHERE l1=-1),COUNT(1)FILTER(WHERE l1!=-1),MIN(l2) is null,
	SUM(CASE WHEN l1 = -1 THEN l2 ELSE 0 END),SUM(l2) FILTER(WHERE l1=-1) FROM numfoo where l1 < -1;
+--------+--------+--------+--------+--------+
| EXPR$0 | EXPR$1 | EXPR$2 | EXPR$3 | EXPR$4 |
+--------+--------+--------+--------+--------+
|      0 |      0 | true   |      0 |        |
+--------+--------+--------+--------+--------+
(1 row)

!ok
-- 0=-1,0
SELECT COUNT(1)FILTER(WHERE l1=-1),COUNT(1)FILTER(WHERE l1!=-1),MIN(l2) is null,
	SUM(CASE WHEN l1 = -1 THEN l2 ELSE 0 END),SUM(l2) FILTER(WHERE l1=-1) FROM numfoo where l1 < 3;
+--------+--------+--------+--------+--------+
| EXPR$0 | EXPR$1 | EXPR$2 | EXPR$3 | EXPR$4 |
+--------+--------+--------+--------+--------+
|      0 |      1 | false  |      0 |        |
+--------+--------+--------+--------+--------+
(1 row)

!ok


-- 0=0,0
SELECT COUNT(1)FILTER(WHERE l1=0),COUNT(1)FILTER(WHERE l1!=0),MIN(l2) is null,
	SUM(CASE WHEN l1 = 0 THEN l2 ELSE 0 END),SUM(l2) FILTER(WHERE l1=0) FROM numfoo where l1 < 3;
+--------+--------+--------+--------+--------+
| EXPR$0 | EXPR$1 | EXPR$2 | EXPR$3 | EXPR$4 |
+--------+--------+--------+--------+--------+
|      1 |      0 | false  |      0 |      0 |
+--------+--------+--------+--------+--------+
(1 row)

!ok

-- all rows match the condition, but all matching values are null: l1 IS NULL selects
-- the three rows that have neither l1 nor l2 set. The D1 rewrite turns
-- SUM(CASE WHEN l1 IS NULL THEN l2 ELSE 0 END) into SUM0(l2) FILTER (WHERE l1 IS NULL),
-- which matches rows but has no non-null value to sum, so it returns NULL and the
-- nvl post-aggregator of the D1 rewrite reports 0. The user-written filtered SUM stays
-- on the native path and keeps the pre-rewrite NULL.
SELECT SUM(CASE WHEN l1 IS NULL THEN l2 ELSE 0 END),SUM(l2) FILTER(WHERE l1 IS NULL) FROM numfoo WHERE l1 IS NULL;
+--------+--------+
| EXPR$0 | EXPR$1 |
+--------+--------+
|      0 |        |
+--------+--------+
(1 row)

!ok

-- window form of a user-written filtered aggregate: must not pick up the D1 rewrite
-- post-aggregator, otherwise Windowing.fromCalciteStuff rejects the translation.
-- The frame is the entire partition and holds the two non-null l2 values (325323 and 0).
SELECT SUM0(l2) FILTER(WHERE l2 IS NOT NULL) OVER () FROM numfoo ORDER BY l1 LIMIT 1;
+--------+
| EXPR$0 |
+--------+
| 325323 |
+--------+
(1 row)

!ok

-- 7=7,null
SELECT COUNT(1)FILTER(WHERE l1=7),COUNT(1)FILTER(WHERE l1!=7),MIN(l2) is null,
	SUM(CASE WHEN l1 = 7 THEN l2 ELSE 0 END),SUM(l2) FILTER(WHERE l1=7) FROM numfoo where 0 < l1 and l1 < 10;
+--------+--------+--------+--------+--------+
| EXPR$0 | EXPR$1 | EXPR$2 | EXPR$3 | EXPR$4 |
+--------+--------+--------+--------+--------+
|      1 |      0 | true   |      0 |        |
+--------+--------+--------+--------+--------+
(1 row)

!ok

LogicalProject(EXPR$0=[$0], EXPR$1=[$1], EXPR$2=[IS NULL($2)], EXPR$3=[CAST($3):BIGINT], EXPR$4=[$4])
  LogicalAggregate(group=[{}], EXPR$0=[COUNT() FILTER $0], EXPR$1=[COUNT() FILTER $1], agg#2=[MIN($2)], EXPR$3=[$SUM0($3) FILTER $4], EXPR$4=[SUM($2) FILTER $0])
    LogicalProject($f0=[IS TRUE(=($0, 7))], $f1=[IS TRUE(<>($0, 7))], l2=[$1], l20=[$1], $f5=[IS TRUE(=($0, 7))])
      LogicalFilter(condition=[SEARCH($0, Sarg[(0L:BIGINT..10L:BIGINT)]:BIGINT)])
        LogicalProject(l1=[$11], l2=[$12])
          LogicalTableScan(table=[[druid, numfoo]])

!druidPlan

!set extendedFilteredSumRewrite false
!use druidtest://?numMergeBuffers=3


-- empty input
SELECT COUNT(1)FILTER(WHERE l1=-1),COUNT(1)FILTER(WHERE l1!=-1),MIN(l2) is null,
	SUM(CASE WHEN l1 = -1 THEN l2 ELSE 0 END),SUM(l2) FILTER(WHERE l1=-1) FROM numfoo where l1 < -1;
+--------+--------+--------+--------+--------+
| EXPR$0 | EXPR$1 | EXPR$2 | EXPR$3 | EXPR$4 |
+--------+--------+--------+--------+--------+
|      0 |      0 | true   |        |        |
+--------+--------+--------+--------+--------+
(1 row)

!ok
-- 0=-1,0
SELECT COUNT(1)FILTER(WHERE l1=-1),COUNT(1)FILTER(WHERE l1!=-1),MIN(l2) is null,
	SUM(CASE WHEN l1 = -1 THEN l2 ELSE 0 END),SUM(l2) FILTER(WHERE l1=-1) FROM numfoo where l1 < 3;
+--------+--------+--------+--------+--------+
| EXPR$0 | EXPR$1 | EXPR$2 | EXPR$3 | EXPR$4 |
+--------+--------+--------+--------+--------+
|      0 |      1 | false  |      0 |        |
+--------+--------+--------+--------+--------+
(1 row)

!ok


-- 0=0,0
SELECT COUNT(1)FILTER(WHERE l1=0),COUNT(1)FILTER(WHERE l1!=0),MIN(l2) is null,
	SUM(CASE WHEN l1 = 0 THEN l2 ELSE 0 END),SUM(l2) FILTER(WHERE l1=0) FROM numfoo where l1 < 3;
+--------+--------+--------+--------+--------+
| EXPR$0 | EXPR$1 | EXPR$2 | EXPR$3 | EXPR$4 |
+--------+--------+--------+--------+--------+
|      1 |      0 | false  |      0 |      0 |
+--------+--------+--------+--------+--------+
(1 row)

!ok

-- all rows match the condition, but all matching values are null (control: rewrite off,
-- so the pre-rewrite expression is evaluated natively and both columns stay NULL)
SELECT SUM(CASE WHEN l1 IS NULL THEN l2 ELSE 0 END),SUM(l2) FILTER(WHERE l1 IS NULL) FROM numfoo WHERE l1 IS NULL;
+--------+--------+
| EXPR$0 | EXPR$1 |
+--------+--------+
|        |        |
+--------+--------+
(1 row)

!ok

-- 7=7,null
SELECT COUNT(1)FILTER(WHERE l1=7),COUNT(1)FILTER(WHERE l1!=7),MIN(l2) is null,
	SUM(CASE WHEN l1 = 7 THEN l2 ELSE 0 END),SUM(l2) FILTER(WHERE l1=7) FROM numfoo where 0 < l1 and l1 < 10;
+--------+--------+--------+--------+--------+
| EXPR$0 | EXPR$1 | EXPR$2 | EXPR$3 | EXPR$4 |
+--------+--------+--------+--------+--------+
|      1 |      0 | true   |        |        |
+--------+--------+--------+--------+--------+
(1 row)

!ok

LogicalProject(EXPR$0=[$0], EXPR$1=[$1], EXPR$2=[IS NULL($2)], EXPR$3=[$3], EXPR$4=[$4])
  LogicalAggregate(group=[{}], EXPR$0=[COUNT() FILTER $0], EXPR$1=[COUNT() FILTER $1], agg#2=[MIN($2)], EXPR$3=[SUM($3)], EXPR$4=[SUM($2) FILTER $0])
    LogicalProject($f1=[IS TRUE(=($0, 7))], $f2=[IS TRUE(<>($0, 7))], l2=[$1], $f4=[CASE(=($0, 7), $1, 0:BIGINT)])
      LogicalFilter(condition=[SEARCH($0, Sarg[(0L:BIGINT..10L:BIGINT)]:BIGINT)])
        LogicalProject(l1=[$11], l2=[$12])
          LogicalTableScan(table=[[druid, numfoo]])

!druidPlan
