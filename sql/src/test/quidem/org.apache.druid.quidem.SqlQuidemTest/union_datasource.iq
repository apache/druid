# Case 6: Column aliasing. The arms read different columns, and the foo2 arm presents its "dim2" as "dim1".
SELECT c, COUNT(*)
FROM (SELECT dim1 AS c, m1 FROM foo UNION ALL SELECT dim2 AS c, m1 FROM foo2)
WHERE c = 'a' OR c = '1'
GROUP BY 1;
+---+--------+
| c | EXPR$1 |
+---+--------+
| 1 |      1 |
+---+--------+
(1 row)

