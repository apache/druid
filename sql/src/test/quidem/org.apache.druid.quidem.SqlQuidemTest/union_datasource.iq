!use druidtest:///
!set outputformat mysql

# Case 1: BIGINT (foo2.m1) vs FLOAT (foo.m1).
SELECT dim1, dim2, SUM(m1), COUNT(*)
FROM (SELECT dim1, dim2, m1 FROM foo2 UNION ALL SELECT dim1, dim2, m1 FROM foo)
WHERE dim2 = 'a' OR dim2 = 'en'
GROUP BY 1, 2;
+-------+------+--------+--------+
| dim1  | dim2 | EXPR$2 | EXPR$3 |
+-------+------+--------+--------+
|       | a    |    1.0 |      1 |
| 1     | a    |    4.0 |      1 |
| druid | en   |    1.0 |      1 |
+-------+------+--------+--------+
(3 rows)

!ok
{
  "queryType" : "groupBy",
  "dataSource" : {
    "type" : "union",
    "dataSources" : [ {
      "type" : "project",
      "base" : {
        "type" : "table",
        "name" : "foo2"
      },
      "virtualColumns" : [ {
        "type" : "expression",
        "name" : "v0",
        "expression" : "CAST(\"m1\", 'DOUBLE')",
        "outputType" : "FLOAT"
      } ]
    }, {
      "type" : "project",
      "base" : {
        "type" : "table",
        "name" : "foo"
      },
      "virtualColumns" : [ {
        "type" : "expression",
        "name" : "v0",
        "expression" : "\"m1\"",
        "outputType" : "FLOAT"
      } ]
    } ]
  },
  "intervals" : {
    "type" : "intervals",
    "intervals" : [ "-146136543-09-08T08:23:32.096Z/146140482-04-24T15:36:27.903Z" ]
  },
  "filter" : {
    "type" : "inType",
    "column" : "dim2",
    "matchValueType" : "STRING",
    "sortedValues" : [ "a", "en" ]
  },
  "granularity" : {
    "type" : "all"
  },
  "dimensions" : [ {
    "type" : "default",
    "dimension" : "dim1",
    "outputName" : "d0",
    "outputType" : "STRING"
  }, {
