# testJoinWithSubqueryOnLeftAndOuterTimeFilter case-crc:229dd4c0
# quidem testcase reason: JOIN_FILTER_LOCATIONS
!set debug true
!set defaultTimeout 300000
!set maxScatterGatherBytes 9223372036854775807
!set plannerStrategy DECOUPLED
!set sqlCurrentTimestamp 2000-01-01T00:00:00Z
!set sqlQueryId dummy
!set outputformat mysql
!use druidtest:///
SELECT base.dim2, lookyloo.v
FROM (SELECT __time, dim2 FROM foo ORDER BY __time LIMIT 10) base
LEFT JOIN lookup.lookyloo ON base.dim2 = lookyloo.k
WHERE base.__time >= TIMESTAMP '2000-01-03 00:00:00';
LogicalProject(dim2=[$1], v=[$3])
  LogicalJoin(condition=[=($1, $2)], joinType=[left])
    LogicalFilter(condition=[>=($0, 2000-01-03 00:00:00)])
      LogicalSort(sort0=[$0], dir0=[ASC], fetch=[10])
        LogicalProject(__time=[$0], dim2=[$2])
          LogicalTableScan(table=[[druid, foo]])
    LogicalTableScan(table=[[lookup, lookyloo]])

!logicalPlan
DruidProject(dim2=[$1], v=[$3], druid=[logical])
  DruidJoin(condition=[=($1, $2)], joinType=[left])
    DruidFilter(condition=[>=($0, 2000-01-03 00:00:00)])
      DruidSort(sort0=[$0], dir0=[ASC], fetch=[10], druid=[logical])
        DruidProject(__time=[$0], dim2=[$2], druid=[logical])
          DruidTableScan(table=[[druid, foo]], druid=[logical])
    DruidTableScan(table=[[lookup, lookyloo]], druid=[logical])

!druidPlan
