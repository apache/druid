# Writes the NVD data cache key and its restore prefix to $GITHUB_OUTPUT:
#   prefix=nvd-odc-<dependency-check version>-
#   key=<prefix><Druid version>
# The DB schema follows the dependency-check version; the Druid version rolls the key once per release.

set -eu

ODC=$(git grep -h -A1 '<artifactId>dependency-check-maven</artifactId>' -- pom.xml | grep -oE '[0-9]+(\.[0-9]+)+')
DRUID=$(./mvnw -B -q -N help:evaluate -Dexpression=project.version -DforceStdout)

echo "prefix=nvd-odc-$ODC-" >> "$GITHUB_OUTPUT"
echo "key=nvd-odc-$ODC-$DRUID" >> "$GITHUB_OUTPUT"
