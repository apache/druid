// The Lezer grammar for DruidSQL. It describes the tokens (and how parentheses nest), which is what the highlighting,
// the bracket matching and the completions need. It does not try to parse the SQL statements.
//
// Run `script/build-grammars.mjs` (part of `script/build`) after changing it.

@top Script { element* }

element {
  Keyword |
  FunctionName |
  Constant |
  TypeName |
  Identifier |
  QuotedIdentifier |
  String |
  Number |
  Operator |
  Parens |
  Punctuation
}

Parens { "(" element* ")" }

@skip { space | Issue | LineComment | BlockComment }

// Which words are keywords, functions, constants or types is decided by a function (rather than with @specialize in
// here) because the functions that the cluster has are only known at runtime
@external specialize { Identifier } specializeIdentifier from "./dsql-tokens" {
  Keyword,
  FunctionName,
  Constant,
  TypeName
}

@tokens {
  space { $[ \t\n\r]+ }

  // The web console marks the parts of a query that have an issue with a comment like this
  Issue { "--:ISSUE:" ![\n]* }

  LineComment { "--" ![\n]* }

  // An unterminated comment lasts until the end of the text
  BlockComment { "/*" blockCommentRest }
  blockCommentRest { ![*] blockCommentRest | "*" blockCommentAfterStar | @eof }
  blockCommentAfterStar { "/" | "*" blockCommentAfterStar | ![/*] blockCommentRest | @eof }

  // Quoted identifiers and string literals do not span lines, an unterminated quote is just a character
  QuotedIdentifier { '"' ![\n"]* '"' }
  String { "'" ![\n']* "'" }

  // The sign is part of the number
  Number { $[+\-]? @digit+ ("." @digit*)? ($[eE] $[+\-]? @digit+)? }

  Identifier { $[a-zA-Z_$] $[a-zA-Z0-9_$]* }

  Operator { $[+\-*/%&|^~<>=!@] }

  "(" ")"

  // Any other character, so that no text is ever a syntax error
  Punctuation { ![] }

  @precedence {
    Issue,
    LineComment,
    BlockComment,
    QuotedIdentifier,
    String,
    Number,
    Identifier,
    Operator,
    "(",
    ")",
    space,
    Punctuation
  }
}

@detectDelim
