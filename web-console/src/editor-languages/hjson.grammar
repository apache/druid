// The Lezer grammar for Hjson (https://hjson.github.io/syntax.html), which includes JSON.
//
// Run `script/build-grammars.mjs` (part of `script/build`) after changing it.

// The braces around the root object can be left out
@top Document { value | rootProperties }

rootProperties { (Property | ",")* }

value {
  True |
  False |
  Null |
  Number |
  String |
  MultilineString |
  QuotelessString |
  Object |
  Array
}

// Commas are optional between the properties and the items that are on separate lines
Object { "{" (Property | ",")* "}" }

Property { PropertyName ":" value }

PropertyName { quotelessKey | String }

Array { "[" (value | ",")* "]" }

@skip { space | LineComment | BlockComment }

// A quoteless key (only before a colon on the same line) and a quoteless string (the rest of the line, unless that is a
// number or a literal) depend on the context, see hjson-tokens.ts
@external tokens quoteless from "./hjson-tokens" { quotelessKey, QuotelessString }

@skip {} {
  // Like in Ace, a string can go over several lines and an unterminated one lasts until the end of the text
  String { stringStart (stringContent | Escape | InvalidEscape)* stringEnd }
}

@local tokens {
  stringEnd { '"' }
  Escape { "\\" ($["\\/bfnrt] | "u" hex hex hex hex) }
  InvalidEscape { "\\" _ }
  hex { $[0-9a-fA-F] }
  @precedence { Escape, InvalidEscape }
  @else stringContent
}

@tokens {
  space { $[ \t\n\r]+ }

  // The quotes are not nodes of their own so that they are highlighted as part of the string
  stringStart { '"' }

  LineComment { ("#" | "//") ![\n]* }

  // An unterminated comment lasts until the end of the text
  BlockComment { "/*" blockCommentRest }
  blockCommentRest { ![*] blockCommentRest | "*" blockCommentAfterStar | @eof }
  blockCommentAfterStar { "/" | "*" blockCommentAfterStar | ![/*] blockCommentRest | @eof }

  // An unterminated multiline string lasts until the end of the text
  MultilineString { "'''" multilineRest }
  multilineRest { !['] multilineRest | "'" multilineQuote | @eof }
  multilineQuote { !['] multilineRest | "'" multilineQuotes | @eof }
  multilineQuotes { "'" | !['] multilineRest | @eof }

  Number { "-"? ("0" | $[1-9] @digit*) ("." @digit+)? ($[eE] $[+\-]? @digit+)? }

  True { "true" }
  False { "false" }
  Null { "null" }

  "{" "}" "[" "]" "," ":"
}

@detectDelim
